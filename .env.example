NODE_ENV=production
PORT=3000

# Long random string — e.g. `openssl rand -hex 32`
JWT_SECRET=

# Your real site, used to build links inside emails
APP_URL=https://northbound.com

# Your front-end's real origin (must match exactly, including protocol)
CORS_ORIGIN=https://northbound.com

# --- Email (SMTP) ---
# Works with any provider: Resend, Postmark, SendGrid, Mailgun, Amazon SES.
# Example values below are for Resend's SMTP relay — swap for your provider's.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=your_provider_api_key_here
EMAIL_FROM=Northbound <no-reply@northbound.com>
